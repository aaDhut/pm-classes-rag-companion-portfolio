# Copy to .env and fill in your own values. Never commit .env.

# Google Cloud (Vertex AI for Gemini + embeddings)
GCP_PROJECT=
VERTEX_LOCATION=us-central1

# Qdrant Cloud vector database
QDRANT_URL=
QDRANT_API_KEY=

# Google Drive folders to index
DRIVE_FOLDER_ID=
VIDEO_FOLDER_ID=

# Lecture transcription
DEEPGRAM_API_KEY=

# Cloud Storage bucket for slide images (and chats on Cloud Run)
IMAGES_BUCKET=
CHATS_BUCKET=

# Optional: ask for a password before showing the chat
APP_PASSWORD=
